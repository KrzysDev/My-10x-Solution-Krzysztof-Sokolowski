# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://<your-project-id>.supabase.co

# Supabase anon/public key (Project Settings → API → Project API keys → anon public)
SUPABASE_KEY=<your-anon-key>

# Supabase service role key — used only for account deletion
# (Project Settings → API → Project API keys → service_role secret)
# Keep this key SECRET — never commit it to Git
SUPABASE_SERVICE_KEY=<your-service-role-key>
